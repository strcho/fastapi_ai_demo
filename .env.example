# 应用配置
APP_NAME=FastAPI Best Practice
APP_VERSION=1.0.0
DEBUG=true

# API 配置
API_V1_STR=/api/v1

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 跨域配置（多个用逗号分隔）
CORS_ORIGINS=*

# 日志配置
LOG_LEVEL=INFO

# MongoDB 配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=fastapi_demo

# Redis 配置
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_CACHE_TTL=3600
